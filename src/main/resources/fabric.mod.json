{
  "schemaVersion": 1,
  "id": "better-clouds-toggle",
  "version": "${version}",
  "name": "Better Clouds Toggle",
  "description": "Adds a key binding that switches Better Clouds on and off (the \"Enable\" option of its settings), without changing Better Clouds itself.",
  "authors": ["Hiveko"],
  "contact": {
    "sources": "https://github.com/Hiveko75/better-clouds-toggle",
    "issues": "https://github.com/Hiveko75/better-clouds-toggle/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.hiveko.cloudstoggle.BetterCloudsToggle"]
  },
  "depends": {
    "fabricloader": ">=${loader_min}",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}",
    "betterclouds": "*"
  }
}
